{
  "browser": {
    "mode": "launch",
    "executable_path": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "headless": true
  },
  "start_url": {
    "url": "https://www.fatemaster.ai/workspace",
    "query": []
  },
  "environment": {
    "viewport": { "width": 1440, "height": 900, "device_scale_factor": 1 },
    "locale": "zh-CN",
    "timezone": "Asia/Shanghai",
    "color_scheme": "light",
    "reduced_motion": "reduce",
    "service_workers": "block"
  },
  "actions": [
    { "step_id": "settle1", "action": "wait_for_timeout", "duration_ms": 6000 },
    { "step_id": "scrollend", "action": "press", "locator": { "kind": "css", "selector": "body" }, "key": "End" },
    { "step_id": "settle2", "action": "wait_for_timeout", "duration_ms": 3000 }
  ],
  "capture": {
    "after_each_step": [],
    "at_end": ["url", "dom", "accessibility", "storage", "screenshot"],
    "events": ["console", "page-errors", "network", "websockets"],
    "network": { "request_body": true, "response_body": true, "header_values": true }
  }
}
